# Copy this file to .env.local and fill it in. Never commit .env.local.

# ─── Database ─────────────────────────────────────────────────────
# Any Postgres 14 or newer. This value matches docker-compose.yml, so it
# works as-is after `npm run db:up`.
DATABASE_URL=postgres://dua:dua@localhost:54329/dua

# ─── App ──────────────────────────────────────────────────────────

# Break-glass owner password for /admin (pick something strong).
# Sign in by leaving the email field blank. Use it to create the first named
# admin account under the Team tab, then rotate it and keep it somewhere safe.
# Day-to-day sign-ins should use individual accounts.
ADMIN_PASSWORD=

# Any random string of 32+ characters. Signs session cookies, submission
# edit links and unsubscribe links. Changing it signs everyone out and
# breaks links already sent.
# Generate one with: openssl rand -hex 32
SUBMISSION_EDIT_SECRET=

# The public address of this deployment, no trailing slash. Used for links
# and images inside emails, so it must be reachable from an inbox.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (optional) ─────────────────────────────────────────────
# Needed for campaign emails and for emailing teams their edit link. Leave
# blank to run without email. Set ONE of the two below.

# Resend API key (https://resend.com). A send-only key is enough.
RESEND_API_KEY=

# Or any SMTP server, e.g. smtps://user:password@smtp.example.org:465
# For the local test inbox (docker compose --profile tools up -d mailpit):
#   SMTP_URL=smtp://localhost:1025
SMTP_URL=

# The From header, on a domain your email provider has verified.
# EMAIL_FROM="My Hackathon <noreply@mydomain.org>"
EMAIL_FROM=

# ─── File storage (optional) ──────────────────────────────────────
# Where uploaded images go. The default keeps them in the database.
# STORAGE_PROVIDER=database | s3 | supabase

# For STORAGE_PROVIDER=s3. The bucket must allow public reads.
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_ENDPOINT=            # leave unset for AWS; set for R2, B2, Spaces…
# S3_PUBLIC_URL=          # where files are served from, if different

# ─── Supabase (optional) ──────────────────────────────────────────
# Not needed to use Supabase as your database: that only takes DATABASE_URL.
# These are for letting Supabase handle judge sign-in and/or file storage.
# AUTH_PROVIDER=supabase
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=    # server only. Never expose it to the browser.

# ─── Advanced (optional) ──────────────────────────────────────────

# Which event in the database this deployment serves. Defaults to "default".
# DUA_EVENT_SLUG=default

# Most connections the app opens to Postgres. Defaults to 10.
# DATABASE_POOL_MAX=10

# ─── Database and sign-in (Supabase, for now) ─────────────────────
# From Supabase → Settings → API. The roadmap in README.md replaces this
# with any Postgres database.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Public key (safe in the browser). Supabase shows this as either
# "Publishable key" (new) or "anon public" (legacy). The code accepts both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy name, also works

# Server-only. Bypasses row-level security. NEVER expose to the browser.
# Supabase labels this either "Secret key" (new) or "service_role" (legacy).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=       # legacy name, also works

# ─── App ──────────────────────────────────────────────────────────

# Break-glass owner password for /admin (pick something strong).
# Sign in by leaving the email field blank. Use it to create the first named
# admin account under the Team tab, then rotate it and keep it somewhere safe.
# Day-to-day sign-ins should use individual accounts.
ADMIN_PASSWORD=

# Any random string of 32+ characters. Signs admin session cookies,
# submission edit links and unsubscribe links.
# Generate one with: openssl rand -hex 32
SUBMISSION_EDIT_SECRET=

# The public address of this deployment, no trailing slash. Used for links
# and the logo inside emails, so it must be reachable from an inbox.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (optional) ─────────────────────────────────────────────
# Needed for campaign emails and submission edit links. Leave blank to run
# without email.

# Resend API key. A send-only ("restricted") key is enough.
RESEND_API_KEY=

# The From header, on a domain your email provider has verified.
# EMAIL_FROM="My Hackathon <noreply@mydomain.org>"
EMAIL_FROM=

{
  "name": "dua-platform",
  "version": "0.1.0",
  "description": "Open source hackathon platform: registration, submissions, fair judging and results.",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.9.0"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ]
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.13"
    },
    "browserslist": "4.29.5",
    "js-yaml": "4.3.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck",
    "verify:full": "npm run verify && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:up": "docker compose up -d db",
    "db:seed": "node --env-file-if-exists=.env.local scripts/demo-data.mjs",
    "test:live": "LIVE_TESTS=1 vitest run",
    "prepare": "node scripts/prepare-husky.mjs",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "create-branch": "node scripts/create-branch.mjs",
    "pr": "node scripts/create-pr.mjs",
    "check:branch": "node scripts/check-branch-name.mjs",
    "labels": "node scripts/setup-labels.mjs",
    "protect-branches": "node scripts/apply-branch-protection.mjs",
    "docker:build": "docker build -t dua-platform:local .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env.local dua-platform:local"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "8.5.33",
    "prettier": "3.9.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
